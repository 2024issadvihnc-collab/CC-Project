# =============================================================================
# ShowTime Environment Configuration Template
# Copy this file to .env and customize secrets before deployment
# =============================================================================

# Deployment Environment
NODE_ENV=production

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password_123
POSTGRES_DB=showtime_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache & Lock Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication Secrets
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Microservices Network Routing (Internal Docker Network)
AUTH_SERVICE_URL=http://auth-service:5001
EVENT_SERVICE_URL=http://event-service:5002
BOOKING_SERVICE_URL=http://booking-service:5003
PAYMENT_SERVICE_URL=http://payment-service:5004
TICKET_SERVICE_URL=http://ticket-service:5005

# Frontend Reverse Proxy Target (for Two-EC2 Deployment)
# In Two-EC2 AWS setup: set to http://<BACKEND_EC2_PRIVATE_IP>:5000
BACKEND_API_URL=http://api-gateway:5000

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:80

