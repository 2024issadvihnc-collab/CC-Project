# ==============================================================================
# ShowTime Backend Environment Configuration Example
# Copy this file to .env and fill in your actual infrastructure values.
# NEVER commit the actual .env file containing secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration (Amazon RDS PostgreSQL)
# Format: postgresql://<username>:<password>@<rds-endpoint>:5432/<database-name>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/showtimedb
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=10000

# Cache & Temporary State (Amazon ElastiCache for Redis)
# Format: redis://<redis-primary-endpoint>:6379 or rediss:// for in-transit encryption
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# Authentication & Security
# Generate a strong 256-bit random string for production (e.g., openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS Allowed Origins (Comma-separated list of CloudFront or frontend domains)
# Example: https://d111111abcdef8.cloudfront.net,https://showtime.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OTP & Verification Settings
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
ALLOW_DEMO_OTP=true

# Seat Hold & Concurrency Configuration
SEAT_HOLD_DURATION_SECONDS=600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

