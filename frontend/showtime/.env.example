# ShowTime Frontend Environment Configuration
# Use this file as a template for configuring environment variables.

# API Base URL for backend communication:
# Development (Vite dev proxy or direct backend URL):
# VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=http://localhost:5000/api

# Production (CloudFront unified domain or custom API domain):
# VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_API_BASE_URL=/api

