{
  "name": "showtime-monorepo",
  "version": "1.0.0",
  "description": "ShowTime Event & Ticket Booking Microservices Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared/*",
    "services/*",
    "api-gateway",
    "frontend/showtime"
  ],
  "scripts": {
    "start:gateway": "node api-gateway/server.js",
    "start:auth": "node services/auth-service/server.js",
    "start:event": "node services/event-service/server.js",
    "start:booking": "node services/booking-service/server.js",
    "start:payment": "node services/payment-service/server.js",
    "start:ticket": "node services/ticket-service/server.js",
    "start:all": "node scripts/start-all-microservices.js",
    "test:microservices": "node scripts/test-microservices.js",
    "test:concurrency": "node scripts/test-concurrency-microservices.js",
    "test:saga": "node scripts/test-saga-payment-failure.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.4"
  }
}
